{
  "name": "ai-support-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:widget && next dev",
    "build": "npm run build:widget && next build",
    "start": "next start",
    "build:widget": "esbuild widget/widget.ts --bundle --minify --format=iife --target=es2018 --outfile=public/widget.js",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshots": "tsx scripts/screenshots.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "live-check": "tsx scripts/live-check.ts",
    "lint": "eslint .",
    "start:public-demo": "node scripts/serve-public-demo.mjs",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
