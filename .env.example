# ---- Sağlayıcı ----
# demo | gemini | claude. Anahtar yoksa her durumda demo moduna düşer (maliyet yok).
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# local (ücretsiz, çevrimdışı) | gemini (GEMINI_API_KEY gerekir)
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=gemini olduğunda kullanılır
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---- Limitler ----
RATE_LIMIT_PER_MINUTE=8
DAILY_REQUEST_LIMIT=300
MAX_QUESTION_CHARS=500
MAX_CONTEXT_TOKENS=1500
MAX_OUTPUT_TOKENS=350

# ---- Yönetim paneli ----
# Canlı modda zorunlu. Demo modunda boşsa panel şifresiz açılır.
ADMIN_PASSWORD=
# Cookie imzası ve IP hash'i için rastgele uzun bir değer
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Veri ----
# Yerel JSON veritabanının klasörü (Vercel'de otomatik /tmp)
DATA_DIR=data
