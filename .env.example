# ---- Sağlayıcı ----
# demo | gemini | claude | ollama. Gemini/Claude anahtarı yoksa demo moduna düşer (maliyet yok).
# ollama: bu bilgisayarda çalışan yerel model, anahtar ve kota yok.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# local (ücretsiz, çevrimdışı) | gemini (GEMINI_API_KEY gerekir) | ollama (yerel)
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=gemini olduğunda kullanılır
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---- Ollama (yerel) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
# çok dilli (Türkçe dahil) embedding modeli
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT_MS=120000
# düşünen modellerde (qwen3.x vb.) false yapın; boşsa alan hiç gönderilmez
OLLAMA_THINK=

# ---- "Bilmiyorum" eşiği (anlamsal embedding için) ----
# Boşsa gemini-embedding-2 kalibrasyonu kullanılır. Başka bir modelde `npm run calibrate`
# çalıştırıp yazdırdığı değerleri buraya yapıştırın.
RETRIEVAL_WEIGHT_COS=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_MIN_COVERAGE=

# ---- Limitler ----
RATE_LIMIT_PER_MINUTE=8
DAILY_REQUEST_LIMIT=300
MAX_QUESTION_CHARS=500
MAX_CONTEXT_TOKENS=1500
MAX_OUTPUT_TOKENS=350

# ---- Yönetim paneli ----
# Canlı modda zorunlu. Demo modunda boşsa panel şifresiz açılır.
ADMIN_PASSWORD=
# Cookie imzası ve IP hash'i için rastgele uzun bir değer
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Veri ----
# Kalıcı veritabanı (Postgres). Vercel Marketplace'ten Neon eklenince otomatik gelir.
# Boşsa yerel JSON dosyası kullanılır (Vercel'de /tmp: her soğuk başlangıçta sıfırlanır).
DATABASE_URL=
# Yerel JSON veritabanının klasörü (Vercel'de otomatik /tmp)
DATA_DIR=data

# ---- "Kendi sitenizle deneyin" (/try) ----
# Ziyaretçi site adresini (veya SSS metni / dosya) verir, geçici bir deneme asistanı oluşur.
# Siteden en fazla TRY_MAX_PAGES sayfa okunur; özel/yerel ağ adresleri ve yönlendirmeleri engellenir.
TRY_ENABLED=true
TRY_MAX_PAGES=8
# Deneme asistanının ömrü (saat). "Sitemde istiyorum" diyenlerde 7 gün tutulur.
TRY_TTL_HOURS=24
TRY_PER_IP_PER_HOUR=3
TRY_DAILY_LIMIT=30
TRY_MAX_CHARS=60000
# Yalnızca yerel test: localhost / özel IP / standart dışı port okunabilsin. Üretimde asla açmayın.
TRY_ALLOW_PRIVATE=
